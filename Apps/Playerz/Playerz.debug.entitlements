<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- SANDBOX. A development build registers against sandbox APNs, the
       server's APNS_*_SANDBOX settings. Must agree with
       PushRegistrar.environment, which derives the same answer from #if DEBUG. -->
  <key>aps-environment</key>
  <string>development</string>
  <!-- Universal links (playerz-ios#24): a playerz.bg link the app can open
       opens it rather than Safari. Which paths is the server's choice, in
       its /.well-known/apple-app-site-association; today only invites to a
       booking. -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:playerz.bg</string>
  </array>
  <key>com.apple.developer.weatherkit</key>
  <true/>
</dict>
</plist>
