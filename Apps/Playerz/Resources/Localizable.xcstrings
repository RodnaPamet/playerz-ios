    "profile.delete.exportFirst": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако искате копие на данните си, изтеглете го преди това."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want a copy of your data, download it first."
          }
        }
      }
    },
    "profile.delete.intro": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриването е веднага и е окончателно. Изтриват се името, имейлът, снимката, спортовете, известията и отзивите ви. Изиграните резервации остават в клубовете под името „Изтрит потребител“, защото от тях се изчисляват сметките им."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion happens at once and can’t be undone. Your name, email, picture, sports, notifications and reviews are deleted. Bookings you have played stay with the clubs as “Deleted user”, because their statements are worked out from them."
          }
        }
      }
    },
    "profile.delete.noShowCarry": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неявяванията ви в клуб и блокировката за онлайн резервации там не изчезват с профила. Пазим ги до 90 дни от всяко неявяване, свързани със защитен отпечатък на имейла ви, без името ви. Ако създадете нов профил със същия имейл, те се прехвърлят на него."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No-shows at a club, and any block on booking there online, do not go away with the account. They are kept for up to 90 days from each no-show, tied to a protected fingerprint of your email address, not to your name. If you make a new account with the same address, they move to it."
          }
        }
      }
    },
    "profile.delete.title": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтриване на профила"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account"
          }
        }
      }
    },
