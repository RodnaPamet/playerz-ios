          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "As a coach you have %lld upcoming lesson. Cancel them, or wait until they are over, before deleting the account."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "As a coach you have %lld upcoming lessons. Cancel them, or wait until they are over, before deleting the account."
