        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel it until %@."
          }
        }
      }
    },
    "profile.delete.blocked.leave": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да напуснете играта до началото ѝ."
