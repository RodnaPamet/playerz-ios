    "profile.delete.creditRule": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизползваният кредит в клубовете не се връща след изтриване на профила. Използвайте го или попитайте клуба какво може да се направи, преди да изтриете профила."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused credit at a club is not returned once the account is deleted. Use it, or ask the club what can be done, before you delete your account."
          }
        }
      }
    },
    "profile.delete.dialog.body": {
      "localizations": {
