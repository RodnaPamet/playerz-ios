    "profile.delete.club.body": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Профил на клуб не може да се изтрие от приложението. Пишете ни през формата за контакт и ние ще го изтрием."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A club account can’t be deleted from the app. Write to us through the contact form and we will delete it."
          }
