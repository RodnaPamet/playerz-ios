    "phone.step.privacy": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Номерът потвърждава, че профилът е ваш. Други играчи не го виждат. Клуб го вижда само докато имате предстояща резервация при него, за да може да ви се обади за нея."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number confirms the account is yours. Other players never see it. A club sees it only while you have an upcoming booking there, so it can call you about it."
          }
        }
      }
    },
