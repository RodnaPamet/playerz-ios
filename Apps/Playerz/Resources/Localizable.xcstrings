    "profile.delete.blocked.body": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Профилът може да се изтрие, когато нямате предстоящи резервации. Отменете тези, които сте направили, и напуснете тези, към които са ви добавили."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your account once you have no upcoming bookings. Cancel the ones you made and leave the ones you were added to."
          }
        }
      }
    },
