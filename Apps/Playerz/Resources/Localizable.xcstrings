    "club.description": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Клубът се управлява от playerz.bg в браузъра: календар, кортове, играчи и съобщения. Приложението е за играчи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A club is run from playerz.bg in a browser: its calendar, courts, players and messages. The app is for players."
          }
        }
      }
