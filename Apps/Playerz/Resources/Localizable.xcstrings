    "bookingGame.intro": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Липсват ви играчи? Пуснете играта в Игри и други ще могат да поискат място. Вие решавате кого да приемете."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short of players? Put the game in Games and others can ask for a spot. You decide whom to accept."
          }
        }
      }
    },
