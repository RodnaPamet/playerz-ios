    "coaches.lesson.sheet.noOnlineCancel %lld": {
      "localizations": {
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Урокът може да се отмени до %lld час преди началото. Този час започва по-скоро, затова след потвърждаване отмяната е възможна само чрез клуба."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Урокът може да се отмени до %lld часа преди началото. Този час започва по-скоро, затова след потвърждаване отмяната е възможна само чрез клуба."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The lesson can be cancelled up to %lld hour before it starts. This one starts sooner, so once confirmed it can only be cancelled through the club."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The lesson can be cancelled up to %lld hours before it starts. This one starts sooner, so once confirmed it can only be cancelled through the club."
                }
              }
            }
          }
        }
      }
    },
