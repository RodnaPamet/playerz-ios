<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- PRODUCTION. TestFlight and the App Store both register against
       production APNs, served by the 6CBHGM6X55 key.

       Split per configuration on purpose. A single entitlements file has to
       pick one, and picking `development` means every TestFlight build asks
       Apple for a sandbox token, registers it as PRODUCTION (because
       PushRegistrar derives that from #if DEBUG), and gets BadDeviceToken —
       which, before #208, DELETED the registration. The entitlement and the
       environment the app reports must come from the same switch. -->
  <key>aps-environment</key>
  <string>production</string>
  <key>com.apple.developer.weatherkit</key>
  <true/>
</dict>
</plist>
